{
  "name": "codex-quota-guard-mcp",
  "version": "2.0.0",
  "description": "Plan-aware adaptive Codex quota guard, passive learning, and checkpoint MCP server",
  "type": "module",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valentine-89/codex-quota-guard-mcp.git"
  },
  "homepage": "https://github.com/valentine-89/codex-quota-guard-mcp#readme",
  "bugs": {
    "url": "https://github.com/valentine-89/codex-quota-guard-mcp/issues"
  },
  "keywords": [
    "codex",
    "mcp",
    "quota",
    "checkpoint",
    "model-context-protocol"
  ],
  "bin": {
    "codex-quota-guard-mcp": "dist/main.js"
  },
  "files": [
    "dist",
    "examples",
    "scripts",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "doctor": "node dist/main.js --doctor",
    "acceptance:live": "node scripts/live-acceptance.mjs",
    "acceptance:shared": "node scripts/shared-core-acceptance.mjs",
    "acceptance:install": "node scripts/install-acceptance.mjs",
    "start:http": "node dist/core.js"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "smol-toml": "1.8.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  }
}
